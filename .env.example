# Bayora Environment Configuration
# SECURITY: Never put secret tokens or keys in this file. Secrets live in secrets/

COMPOSE_PROJECT_NAME=bayora
WEB_BIND=127.0.0.1:8088
DOMAIN=bayora.local

# Model configuration
MODEL_FILE=Qwen2.5-0.5B-Instruct-Q4_K_M.gguf
MODEL_THREADS=2
MODEL_CTX=8192
MODEL_PARALLEL=2
MODEL_MEM_LIMIT=2g
MODEL_CPUS=2.0

# Evaluation & Cache settings
DEFAULT_CACHE_MODE=isolated
MAX_ATTACKS=100
ATTACK_MAX_TOKENS=96
RUN_TIMEOUT_SECONDS=600

# Rate limits
RATE_LIMIT_PUBLIC_PER_MIN=60
RATE_LIMIT_TENANT_PER_SEC=10
